{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cooltv-mac",
  "version": "0.1.2",
  "identifier": "com.gaobo.cooltv-mac",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Feel Cool TV",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "fullscreen": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
